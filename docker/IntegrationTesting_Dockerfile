FROM rust:latest AS builder

WORKDIR /usr/src/app

COPY ../ .

RUN cargo test -p tests --release --no-run

CMD if [ -z "$TEST_NAME" ]; then                                    \
        cargo test --package tests --release --no-fail-fast;        \
    else                                                            \
        cargo test --package tests --release -- --test $TEST_NAME;  \
    fi
